rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /user_challenges/{challengeId} {
      allow read, write: if true;
    }
    match /user_trades/{tradeId} {
      allow read, write: if true;
    }
    match /user_milestones/{milestoneId} {
      allow read, write: if true;
    }
    match /community_users/{userId} {
      allow read, write: if true;
    }
    match /community_channels/{channelId} {
      allow read, write: if true;
    }
    match /chat_messages/{messageId} {
      allow read, write: if true;
    }
    match /private_messages/{messageId} {
      allow read, write: if true;
    }
    match /user_warnings/{warningId} {
      allow read, write: if true;
    }
    match /community_notifications/{notificationId} {
      allow read, write: if true;
    }
    match /media_files/{mediaId} {
      allow read, write: if true;
    }
    match /app_update_config/{configId} {
      allow read: if true;
      allow write: if true;
    }
    match /subscription_plans/{planId} {
      allow read, write: if true;
    }
    match /user_subscriptions/{subId} {
      allow read, write: if true;
    }
    match /user_fcm_tokens/{tokenId} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
